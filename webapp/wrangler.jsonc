{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "split-ledger-webapp",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "split-ledger-db",
      // Local development only. This placeholder can never be deployed; hosted builds use
      // the named environments below through the guarded npm scripts.
      "database_id": "local-development-placeholder",
      "migrations_dir": "migrations"
    },
    {
      // Pilot logbook (WEB-048): a separate database that never holds financial data.
      "binding": "LOGBOOK",
      "database_name": "split-ledger-logbook",
      "database_id": "local-logbook-placeholder",
      "migrations_dir": "logbook-migrations"
    }
  ],
  // Daily removal of logbook rows older than 180 days.
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    // Fictional staging on workers.dev (Batch 7a). Database created 2026-10-25 with
    // `wrangler d1 create split-ledger-staging`; the id is not secret.
    "staging": {
      "name": "split-ledger-staging",
      "workers_dev": true,
      "d1_databases": [
        { "binding": "DB", "database_name": "split-ledger-staging", "database_id": "cb8833cb-8ec4-4053-8536-47e1338bbc26", "migrations_dir": "migrations" },
        { "binding": "LOGBOOK", "database_name": "split-ledger-telemetry-staging", "database_id": "6b9bcb10-2668-4d32-b348-812543979ee0", "migrations_dir": "logbook-migrations" }
      ],
      "triggers": { "crons": ["17 3 * * *"] },
      "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] }
    },
    // Real pilot on the owner's domain (Batch 7b). Separate name, database, keys, and address;
    // no workers.dev address. Both databases created 2026-10-26 with `wrangler d1 create`;
    // the ids are not secret.
    "production": {
      "name": "split-ledger-production",
      "workers_dev": false,
      "routes": [{ "pattern": "app.tallywithus.com", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "split-ledger-production", "database_id": "4fd32d21-5ec9-4371-8fa5-4e6d9dbef2cb", "migrations_dir": "migrations" },
        { "binding": "LOGBOOK", "database_name": "split-ledger-telemetry", "database_id": "43b0c195-6fa9-4221-ad97-6da46c9a2641", "migrations_dir": "logbook-migrations" }
      ],
      "triggers": { "crons": ["17 3 * * *"] },
      "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] }
    }
  }
}
