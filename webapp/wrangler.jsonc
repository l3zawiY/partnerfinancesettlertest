{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "split-ledger-webapp",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "split-ledger-db",
      // Local development only. Keep this non-deployable placeholder until the owner
      // separately authorizes named staging and production resources in Batch 7.
      "database_id": "local-development-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
